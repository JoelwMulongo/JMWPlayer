<Window x:Class="JMWPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="JMWPlayer" Height="540" Width="960" MinWidth="640" MinHeight="360"
        AllowDrop="True" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <vlc:VideoView x:Name="VideoView" Grid.Row="0" Background="Black"/>

        <Grid x:Name="ControlBar" Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Open" Padding="12,4" Focusable="False"
                    Click="Open_Click"/>
            <Button Grid.Column="1" Content="Play / Pause" Padding="12,4" Margin="8,0,0,0"
                    Focusable="False" Click="PlayPause_Click"/>

            <TextBlock x:Name="CurrentText" Grid.Column="2" Text="0:00"
                       VerticalAlignment="Center" Margin="12,0,6,0"/>

            <Slider x:Name="Seek" Grid.Column="3" Minimum="0" Maximum="1"
                    VerticalAlignment="Center" Focusable="False" IsMoveToPointEnabled="True"
                    Thumb.DragStarted="Seek_DragStarted"
                    Thumb.DragCompleted="Seek_DragCompleted"/>

            <TextBlock x:Name="TotalText" Grid.Column="4" Text="0:00"
                       VerticalAlignment="Center" Margin="6,0,12,0"/>

            <Slider x:Name="Volume" Grid.Column="5" Width="110" Minimum="0" Maximum="100"
                    Value="80" VerticalAlignment="Center" Focusable="False"
                    ValueChanged="Volume_Changed"/>
        </Grid>
    </Grid>
</Window>